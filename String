-- UI framework template for Roblox Luau. Game-specific functions must be connected separately.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local player = Players.LocalPlayer
local guiParent = player:WaitForChild("PlayerGui")

local YRZ = {}; YRZ.__index = YRZ
YRZ.Colors = {
    Background = Color3.fromRGB(5,7,16), Panel = Color3.fromRGB(12,14,29), Panel2 = Color3.fromRGB(18,20,39),
    Purple = Color3.fromRGB(185,62,255), Violet = Color3.fromRGB(126,55,255), Cyan = Color3.fromRGB(0,220,255),
    Magenta = Color3.fromRGB(255,54,216), Text = Color3.fromRGB(245,242,255), Muted = Color3.fromRGB(157,158,181), Off = Color3.fromRGB(47,49,68)
}
local C = YRZ.Colors
local function new(class, props, parent)
    local o = Instance.new(class)
    for k,v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, r) new("UICorner", {CornerRadius=UDim.new(0,r or 10)}, o) end
local function outline(o, color, transparency)
    new("UIStroke", {Color=color or C.Purple, Transparency=transparency or .2, Thickness=1}, o)
end
local function text(parent, value, size, color, font)
    return new("TextLabel", {BackgroundTransparency=1, Text=value, TextSize=size or 13, TextColor3=color or C.Text,
        Font=font or Enum.Font.Gotham, TextXAlignment=Enum.TextXAlignment.Left, TextYAlignment=Enum.TextYAlignment.Center}, parent)
end
local function tw(o, time, props) TweenService:Create(o,TweenInfo.new(time or .18,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),props):Play() end

