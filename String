    local online=text(self.Content,"NEON  •  ONLINE",10,C.Cyan,Enum.Font.GothamMedium); online.AnchorPoint=Vector2.new(1,0); online.Position=UDim2.new(1,-24,0,24); online.Size=UDim2.fromOffset(140,24); online.TextXAlignment=Enum.TextXAlignment.Right
    self.Pages=new("Frame",{Position=UDim2.fromOffset(22,70),Size=UDim2.new(1,-44,1,-88),BackgroundTransparency=1},self.Content)
    self.Search:GetPropertyChangedSignal("Text"):Connect(function() self:Filter(self.Search.Text) end)
    local function fit() local cam=workspace.CurrentCamera; if cam then self.Scale.Scale=math.min(1,cam.ViewportSize.X/1060,cam.ViewportSize.Y/680) end end
    fit(); if workspace.CurrentCamera then table.insert(self.Connections,workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)) end
    -- drag window from header area
    local dragging, start, origin = false,nil,nil
    self.Search.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; start=i.Position; origin=self.Main.Position end end)
    table.insert(self.Connections,UIS.InputChanged:Connect(function(i) if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then local d=i.Position-start; self.Main.Position=UDim2.new(origin.X.Scale,origin.X.Offset+d.X,origin.Y.Scale,origin.Y.Offset+d.Y) end end))
    table.insert(self.Connections,UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end end))
    return self
end

function YRZ:CreateTab(name, icon)
    local tab={Name=name,Icon=icon or "◆",Sections={},Items={}}
    tab.Page=new("ScrollingFrame",{Name=name.."Page",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=3,ScrollBarImageColor3=C.Purple,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),Visible=false},self.Pages)
    new("UIListLayout",{Padding=UDim.new(0,11),SortOrder=Enum.SortOrder.LayoutOrder},tab.Page)
    new("UIPadding",{PaddingTop=UDim.new(0,2),PaddingBottom=UDim.new(0,8),PaddingRight=UDim.new(0,4)},tab.Page)
    tab.Button=new("TextButton",{Size=UDim2.new(1,0,0,40),BackgroundTransparency=1,Text="",AutoButtonColor=false,BorderSizePixel=0},self.Nav); round(tab.Button,9)
    tab.IconLabel=text(tab.Button,icon or "◆",17,C.Muted,Enum.Font.GothamMedium); tab.IconLabel.Position=UDim2.fromOffset(9,0); tab.IconLabel.Size=UDim2.fromOffset(27,40); tab.IconLabel.TextXAlignment=Enum.TextXAlignment.Center
    tab.Title=text(tab.Button,name,12,C.Muted,Enum.Font.GothamMedium); tab.Title.Position=UDim2.fromOffset(43,0); tab.Title.Size=UDim2.new(1,-48,1,0)
    function tab:SetActive(active)
        self.Page.Visible=active; tw(self.Button,.16,{BackgroundTransparency=active and 0 or 1,BackgroundColor3=Color3.fromRGB(38,17,58)})
        tw(self.Title,.16,{TextColor3=active and C.Text or C.Muted}); tw(self.IconLabel,.16,{TextColor3=active and C.Cyan or C.Muted})
        local s=self.Button:FindFirstChildOfClass("UIStroke"); if active and not s then outline(self.Button,C.Purple,.2) elseif not active and s then s:Destroy() end
    end
    tab.Button.Activated:Connect(function() self:SelectTab(name) end)
    table.insert(self.Tabs,tab); if not self.ActiveTab then self:SelectTab(name) end
    return tab
end
function YRZ:SelectTab(name)
    for _,t in ipairs(self.Tabs) do local active=t.Name==name; t:SetActive(active); if active then self.ActiveTab=t end end
end
function YRZ:CreateSection(tab,name)
    assert(tab and tab.Page,"Use a tab returned by Window:CreateTab")
    local sec={Name=name,Tab=tab,Items={}}
    sec.Frame=new("Frame",{Name=name.."Section",Size=UDim2.new(1,-3,0,46),AutomaticSize=Enum.AutomaticSize.Y,BackgroundColor3=C.Panel,BackgroundTransparency=.08,BorderSizePixel=0},tab.Page); round(sec.Frame,12); outline(sec.Frame,C.Purple,.55)
    local heading=text(sec.Frame,"✦  "..name,14,C.Text,Enum.Font.GothamSemibold); heading.Position=UDim2.fromOffset(13,0); heading.Size=UDim2.new(1,-26,0,42)
    sec.Holder=new("Frame",{Position=UDim2.fromOffset(8,44),Size=UDim2.new(1,-16,0,0),AutomaticSize=Enum.AutomaticSize.Y,BackgroundTransparency=1},sec.Frame)
    new("UIListLayout",{Padding=UDim.new(0,5),SortOrder=Enum.SortOrder.LayoutOrder},sec.Holder); new("UIPadding",{PaddingBottom=UDim.new(0,8)},sec.Holder)
    table.insert(tab.Sections,sec); return sec
end
local function row(sec,name,height)
    local r=new("Frame",{Name=name or "Item",Size=UDim2.new(1,0,0,height or 50),BackgroundColor3=C.Panel2,BackgroundTransparency=.25,BorderSizePixel=0},sec.Holder); round(r,9); return r
end
function YRZ:CreateLabel(sec, value)
    local r=row(sec,"Label",36); local l=text(r,value,12,C.Muted); l.Position=UDim2.fromOffset(12,0); l.Size=UDim2.new(1,-24,1,0)
    local item={Type="Label",Name=value,SearchText=value,Row=r}; table.insert(sec.Items,item); table.insert(self.Elements,item); return item
end
function YRZ:CreateButton(sec,name,callback)
    local r=row(sec,name,46); local l=text(r,name,13,C.Text,Enum.Font.GothamMedium); l.Position=UDim2.fromOffset(12,0); l.Size=UDim2.new(1,-65,1,0)
    local b=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-9,.5,0),Size=UDim2.fromOffset(34,29),BackgroundColor3=Color3.fromRGB(48,20,75),Text="›",TextColor3=C.Cyan,TextSize=22,Font=Enum.Font.GothamBold,AutoButtonColor=false,BorderSizePixel=0},r); round(b,8); outline(b,C.Purple,.3)
    b.Activated:Connect(function() tw(b,.1,{BackgroundColor3=C.Violet}); task.delay(.12,function() if b.Parent then tw(b,.12,{BackgroundColor3=Color3.fromRGB(48,20,75)}) end end); if callback then local ok,e=pcall(callback); if not ok then warn("[YRZ]",e) end end end)
    local item={Type="Button",Name=name,SearchText=name,Row=r}; table.insert(sec.Items,item); table.insert(self.Elements,item); return item
end
function YRZ:CreateToggle(sec,name,default,callback,description)
    local r=row(sec,name,description and 60 or 48); local l=text(r,name,13,C.Text,Enum.Font.GothamMedium); l.Position=UDim2.fromOffset(12,description and 6 or 0); l.Size=UDim2.new(1,-82,0,23)
    if description then local d=text(r,description,10,C.Muted); d.Position=UDim2.fromOffset(12,29); d.Size=UDim2.new(1,-82,0,18) end
    local b=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-12,.5,0),Size=UDim2.fromOffset(42,23),BackgroundColor3=default and C.Purple or C.Off,Text="",AutoButtonColor=false,BorderSizePixel=0},r); round(b,20)
    local knob=new("Frame",{Position=default and UDim2.new(1,-20,0,3) or UDim2.fromOffset(3,3),Size=UDim2.fromOffset(17,17),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0},b); round(knob,20)
    local item={Type="Toggle",Name=name,SearchText=name.." "..(description or ""),Row=r,Value=default==true}
    function item:Set(v,silent) self.Value=v==true; tw(b,.15,{BackgroundColor3=self.Value and C.Purple or C.Off}); tw(knob,.15,{Position=self.Value and UDim2.new(1,-20,0,3) or UDim2.fromOffset(3,3)}); if not silent and callback then local ok,e=pcall(callback,self.Value); if not ok then warn("[YRZ]",e) end end end
    b.Activated:Connect(function() item:Set(not item.Value,false) end)
    table.insert(sec.Items,item); table.insert(self.Elements,item); return item
end
function YRZ:CreateSlider(sec,name,min,max,default,callback)
    min,max=min or 0,max or 100; default=math.clamp(default or min,min,max)
    local r=row(sec,name,60); local l=text(r,name,12,C.Text,Enum.Font.GothamMedium); l.Position=UDim2.fromOffset(12,3); l.Size=UDim2.new(.7,0,0,22)
    local v=text(r,tostring(default),11,C.Cyan,Enum.Font.GothamSemibold); v.AnchorPoint=Vector2.new(1,0); v.Position=UDim2.new(1,-12,0,3); v.Size=UDim2.fromOffset(45,22); v.TextXAlignment=Enum.TextXAlignment.Right
    local track=new("Frame",{Position=UDim2.new(0,12,0,37),Size=UDim2.new(1,-24,0,6),BackgroundColor3=C.Off,BorderSizePixel=0},r); round(track,5)
    local p=(default-min)/math.max(1,max-min); local fill=new("Frame",{Size=UDim2.new(p,0,1,0),BackgroundColor3=C.Purple,BorderSizePixel=0},track); round(fill,5); new("UIGradient",{Color=ColorSequence.new(C.Magenta,C.Cyan)},fill)
    local dot=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.new(p,0,.5,0),Size=UDim2.fromOffset(13,13),BackgroundColor3=C.Text,BorderSizePixel=0},track); round(dot,10); outline(dot,C.Purple,0)
    local hit=new("TextButton",{Position=UDim2.fromOffset(0,-6),Size=UDim2.new(1,0,1,12),BackgroundTransparency=1,Text="",AutoButtonColor=false},track)
    local item={Type="Slider",Name=name,SearchText=name,Row=r,Value=default}; local active=false
    local function update(x) local q=math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1); local val=math.floor(min+(max-min)*q+.5); item.Value=val; fill.Size=UDim2.new(q,0,1,0); dot.Position=UDim2.new(q,0,.5,0); v.Text=tostring(val); if callback then local ok,e=pcall(callback,val); if not ok then warn("[YRZ]",e) end end end
    hit.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then active=true; update(i.Position.X) end end)
    table.insert(self.Connections,UIS.InputChanged:Connect(function(i) if active and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then update(i.Position.X) end end))
    table.insert(self.Connections,UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then active=false end end))
    table.insert(sec.Items,item); table.insert(self.Elements,item); return item
end
function YRZ:CreateDropdown(sec,name,options,default,callback)
    options=options or {}; local current=default or options[1] or "Selecionar"; local idx=table.find(options,current) or 1
    local r=row(sec,name,48); local l=text(r,name,12,C.Text,Enum.Font.GothamMedium); l.Position=UDim2.fromOffset(12,0); l.Size=UDim2.new(.42,0,1,0)
    local b=new("TextButton",{AnchorPoint=Vector2.new(1,.5),Position=UDim2.new(1,-10,.5,0),Size=UDim2.new(.53,0,0,30),BackgroundColor3=C.Background,Text=tostring(current).."  ▾",TextColor3=C.Cyan,TextSize=11,Font=Enum.Font.GothamMedium,AutoButtonColor=false,BorderSizePixel=0},r); round(b,8); outline(b,C.Purple,.5)
    local item={Type="Dropdown",Name=name,SearchText=name,Row=r,Value=current}; b.Activated:Connect(function() if #options==0 then return end; idx=idx%#options+1; current=options[idx]; item.Value=current; b.Text=tostring(current).."  ▾"; if callback then local ok,e=pcall(callback,current); if not ok then warn("[YRZ]",e) end end end)
    table.insert(sec.Items,item); table.insert(self.Elements,item); return item
end
function YRZ:Notify(title,message,duration)
    local holder=self.Gui:FindFirstChild("Notifications")
    if not holder then holder=new("Frame",{Name="Notifications",AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-18,1,-18),Size=UDim2.fromOffset(300,250),BackgroundTransparency=1},self.Gui); new("UIListLayout",{VerticalAlignment=Enum.VerticalAlignment.Bottom,HorizontalAlignment=Enum.HorizontalAlignment.Right,Padding=UDim.new(0,7)},holder) end
    local card=new("Frame",{Size=UDim2.fromOffset(285,68),BackgroundColor3=C.Panel2,BorderSizePixel=0},holder); round(card,11); outline(card,C.Purple,.2)
    new("Frame",{Size=UDim2.new(0,3,1,-16),Position=UDim2.fromOffset(0,8),BackgroundColor3=C.Cyan,BorderSizePixel=0},card)
    local t=text(card,title or "YRZ Client",13,C.Text,Enum.Font.GothamSemibold); t.Position=UDim2.fromOffset(13,7); t.Size=UDim2.new(1,-22,0,22)
    local m=text(card,message or "",11,C.Muted); m.Position=UDim2.fromOffset(13,30); m.Size=UDim2.new(1,-22,0,28)
    card.BackgroundTransparency=1; tw(card,.2,{BackgroundTransparency=0}); task.delay(duration or 3,function() if card.Parent then tw(card,.18,{BackgroundTransparency=1}); task.wait(.2); if card.Parent then card:Destroy() end end end)
end
function YRZ:Filter(query)
    query=string.lower(query or "")
    for _,item in ipairs(self.Elements) do item.Row.Visible=(query=="" or string.find(string.lower(item.SearchText or item.Name or ""),query,1,true)~=nil) end
    for _,tab in ipairs(self.Tabs) do local any=false; for _,sec in ipairs(tab.Sections) do local has=false; for _,item in ipairs(sec.Items) do if item.Row.Visible then has=true end end; sec.Frame.Visible=has; if has then any=true end end; tab.Button.Visible=(query=="" or any); if query~="" and any then self:SelectTab(tab.Name) end end
end
function YRZ:EnableToggleKey(key)
    table.insert(self.Connections,UIS.InputBegan:Connect(function(input,processed) if not processed and input.KeyCode==(key or Enum.KeyCode.RightControl) then self.Gui.Enabled=not self.Gui.Enabled end end))
end
function YRZ:Destroy()
    for _,c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
    if self.Gui then self.Gui:Destroy() end
end
return YRZ
